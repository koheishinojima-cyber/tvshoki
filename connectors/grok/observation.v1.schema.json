{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tvshoki.grok.observation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "observed_at", "source", "raw_text"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "tvshoki.grok.observation.v1"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["tv", "x", "web", "news", "search", "sns_reaction"]
        },
        "url": { "type": "string" },
        "title": { "type": "string" },
        "account": { "type": "string" },
        "retrieved_at": { "type": "string", "format": "date-time" }
      }
    },
    "raw_text": { "type": "string", "minLength": 1 },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "enum": ["シューイチ", "サタデープラス"]
        },
        "network": { "type": "string" },
        "aired_at": { "type": "string", "format": "date-time" },
        "episode_title": { "type": "string" }
      }
    },
    "product_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_level", "evidence"],
        "anyOf": [
          { "required": ["brand"] },
          { "required": ["product_name"] },
          { "required": ["model_number"] },
          { "required": ["jan"] },
          { "required": ["category"] }
        ],
        "properties": {
          "brand": { "type": "string", "minLength": 1 },
          "product_name": { "type": "string", "minLength": 1 },
          "model_number": { "type": "string", "minLength": 1 },
          "jan": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "claim_level": {
            "type": "string",
            "enum": ["confirmed_on_air", "weak_confirmation", "inferred"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
